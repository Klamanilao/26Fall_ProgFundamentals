def check_number(number): #This line is setting up the parameter 
  if (number % 2 == 0): #This line is to check if its an even number
    str = "even" #Assigning the string to the word "even" 
  else:
    str = "odd" #If the result is not even then it id odd, it is conditional 

  print(f"{number} is an {str} number") #This line is the finished output

num = int(input("Enter a whole number")) #Assigning the input to variable num 
print(check_number(num)) #This calls the check number function
